{
  "name": "apis.tiqr",
  "version": "0.1.0",
  "description": "TypeScript SDK for TiQR Store and Events REST APIs — storefront, admin, and participant",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ticker-Events/apis.tiqr.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./storefront": {
      "types": "./dist/storefront/index.d.ts",
      "import": "./dist/storefront/index.js",
      "require": "./dist/storefront/index.cjs"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js",
      "require": "./dist/admin/index.cjs"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js",
      "require": "./dist/shared/index.cjs"
    },
    "./participant": {
      "types": "./dist/participant/index.d.ts",
      "import": "./dist/participant/index.js",
      "require": "./dist/participant/index.cjs"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "src",
    "tsup.config.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@types/tiqr": "github:Ticker-Events/types.tiqr"
  },
  "devDependencies": {
    "@types/tiqr": "github:Ticker-Events/types.tiqr#feat/participant-event-types",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "tiqr",
    "api",
    "sdk",
    "storefront",
    "ecommerce",
    "events",
    "participant",
    "bookings"
  ],
  "license": "MIT"
}
